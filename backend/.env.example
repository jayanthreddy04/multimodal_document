# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/document_analyzer

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Groq API (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=multimodal-document-analyzer
# Set this for non-US LangSmith workspaces, e.g. https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=
# By default traces store previews of large document text. Set true only if you want full prompts/doc content in LangSmith.
# LANGSMITH_TRACE_FULL_INPUTS=false
# LANGSMITH_TRACE_PREVIEW_LIMIT=700

# Pinecone (https://app.pinecone.io) — optional; semantic search uses MongoDB fallback if skipped
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=document-analyzer
PINECONE_DIMENSION=768
# SKIP_PINECONE=true

# Embeddings (uses Groq-compatible model via LangChain)
EMBEDDING_MODEL=nomic-embed-text-v1_5

# Upload limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads

# CORS
FRONTEND_URL=http://localhost:5174
