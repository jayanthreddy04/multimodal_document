# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/document_analyzer

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Groq API (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Pinecone (https://app.pinecone.io) — optional; semantic search uses MongoDB fallback if skipped
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=document-analyzer
PINECONE_DIMENSION=768
# SKIP_PINECONE=true

# Embeddings (uses Groq-compatible model via LangChain)
EMBEDDING_MODEL=nomic-embed-text-v1_5

# Upload limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads

# CORS
FRONTEND_URL=http://localhost:5174
